generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id              String               @id @default(uuid())
  name            String
  slug            String               @unique
  logo            String?
  settings        Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  budgets         Budget[]
  categories      Category[]
  chatHistory     ChatHistory[]
  dashboards      Dashboard[]
  documents       Document[]
  goals           FinancialGoal[]
  members         OrganizationMember[]
  reports         Report[]
  subscription    Subscription?
  transactions    Transaction[]
  financialAlerts FinancialAlert[]

  @@index([slug])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           OrgRole      @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Subscription {
  id                   String             @id @default(uuid())
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@map("subscriptions")
}

model Invitation {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  role           OrgRole   @default(MEMBER)
  token          String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedBy      String
  createdAt      DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([organizationId])
  @@map("invitations")
}

model User {
  id                    String               @id @default(uuid())
  email                 String               @unique
  passwordHash          String
  displayName           String
  role                  UserRole             @default(USER)
  active                Boolean              @default(true)
  currentOrganizationId String?
  currency              String               @default("EGP")
  safetyReserve         Decimal?             @db.Decimal(12, 2)
  monthlyIncomeTarget   Decimal?             @db.Decimal(12, 2)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  budgets               Budget[]
  dashboards            Dashboard[]
  goals                 FinancialGoal[]
  memberships           OrganizationMember[]
  reports               Report[]
  sessions              Session[]
  transactions          Transaction[]
  financialAlerts       FinancialAlert[]

  @@index([email])
  @@index([role])
  @@index([currentOrganizationId])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id             String          @id @default(uuid())
  organizationId String
  name           String
  icon           String?
  color          String?
  type           TransactionType @default(EXPENSE)
  isDefault      Boolean         @default(false)
  monthlyBudget  Decimal?        @db.Decimal(12, 2)
  createdAt      DateTime        @default(now())
  budgets        Budget[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([id, organizationId])
  @@unique([organizationId, name, type])
  @@index([organizationId])
  @@index([type])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid())
  organizationId  String
  userId          String
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType @default(EXPENSE)
  categoryId      String
  merchant        String?
  date            DateTime
  paymentMethod   PaymentMethod   @default(CARD)
  description     String?
  isRecurring     Boolean         @default(false)
  recurringPeriod String?
  receiptUrl      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category        @relation(fields: [categoryId, organizationId], references: [id, organizationId])
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, date])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@map("transactions")
}

model Budget {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  categoryId     String
  amount         Decimal      @db.Decimal(12, 2)
  month          Int
  year           Int
  alertThreshold Float        @default(0.8)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  category       Category     @relation(fields: [categoryId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, categoryId, month, year])
  @@index([organizationId, userId])
  @@index([userId, month, year])
  @@map("budgets")
}

model FinancialGoal {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  title          String
  targetAmount   Decimal      @db.Decimal(12, 2)
  currentAmount  Decimal      @default(0) @db.Decimal(12, 2)
  targetDate     DateTime
  category       String?
  status         GoalStatus   @default(ACTIVE)
  icon           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, status])
  @@map("financial_goals")
}

model Dashboard {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  title          String
  description    String?
  sqlQuery       String?
  chartConfig    Json?
  isPublic       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([isPublic])
  @@map("dashboards")
}

model Report {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  title          String
  description    String?
  content        Json?
  format         String       @default("PDF")
  s3Path         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("reports")
}

model Document {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  fileType       DocumentType
  s3Path         String
  size           Int?
  uploadedBy     String?
  tags           String[]     @default([])
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([fileType])
  @@index([uploadedBy])
  @@index([createdAt])
  @@map("documents")
}

model ChatHistory {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  agentType      String
  message        String
  response       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@index([agentType])
  @@index([createdAt])
  @@map("chat_history")
}

model FinancialAlert {
  id             String @id @default(uuid())
  organizationId String
  userId         String

  type    String
  title   String
  message String

  severity String @default("INFO")
  status   String @default("UNREAD")

  data Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@map("financial_alerts")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  E_WALLET
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
}

enum UserRole {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum DocumentType {
  PDF
  IMAGE
  VIDEO
  AUDIO
  SPREADSHEET
  DOCUMENT
  OTHER
}
